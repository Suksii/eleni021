# Neon Postgres connection string (pooled)
DATABASE_URL=""
# Random secret (min 32 chars) for signing admin sessions
AUTH_SECRET=""
# Public site URL, no trailing slash — used for metadataBase, sitemap, robots
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Nalog klijenta (uloga admin, CMS) — kreira ga `npm run db:seed`
ADMIN_EMAIL="admin@eleni.me"
ADMIN_PASSWORD="change-me"
# Nalog programera (uloga owner — vidi i /admin/statistika) — kreira ga seed
OWNER_EMAIL=""
OWNER_PASSWORD=""
# Samo na Vercel-u: token Blob store-a (Storage → Blob) — CMS upload slika ide u Blob
# jer je fajl-sistem read-only. Lokalno ostaje prazno (slike idu u public/uploads).
BLOB_READ_WRITE_TOKEN=""
# Resend (https://resend.com) — obaveštenja o narudžbama/upitima vlasniku i potvrde kupcima.
# Prazno = emailovi se ne šalju (samo log). Primalac obaveštenja je `email` iz CMS podešavanja.
RESEND_API_KEY=""
# Pošiljalac. Dok domen nije verifikovan u Resend-u ostaje onboarding@resend.dev
# (tada Resend dozvoljava slanje SAMO na email vlasnika Resend naloga).
EMAIL_FROM="Eleni <onboarding@resend.dev>"
